{
  "name": "dsh-pet",
  "version": "0.3.7-ldm.13",
  "private": true,
  "description": "DSH Pet Windows 独立桌宠应用。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "floating-widget",
    "react"
  ],
  "homepage": "https://github.com/PC2005-cloud/dsh-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PC2005-cloud/dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/PC2005-cloud/dsh-pet/issues"
  },
  "_comment": [
    "此仓库不再作为 DSH Web 插件发布；DSH Pet 的产品入口是 Windows 独立应用。",
    "dsh-pet-work-status-bridge 是单独插件，仅用于 DSH Desktop profile 的工作状态与焦点上报。"
  ],
  "type": "module",
  "main": "desktop-main.cjs",
  "bin": {
    "dsh-pet-standalone": "lib/standalone.js"
  },
  "files": [
    "desktop-main.cjs",
    "lib/standalone.js",
    "lib/standalone-settings.js",
    "lib/*.js",
    "runtime/electron-helper",
    "assets/config.jsonc",
    "assets/logo-rounded.png",
    "assets/webm",
    "assets/fonts",
    "assets/pic",
    "assets/memes"
  ],
  "scripts": {
    "bundle": "tsdown",
    "build:desktop-core": "node scripts/build-desktop-core.mjs",
    "watch": "tsdown --watch",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "standalone": "electron desktop-main.cjs",
    "standalone:cli": "node lib/standalone.js",
    "dev:mock": "node scripts/dev/mock-server.mjs",
    "build": "node scripts/prepare.js",
    "build:exe": "npm run build:exe:public",
    "build:exe:public": "npm run build:rounded-logo && npm run build && npm run check:desktop-package && node scripts/build-windows-icon.mjs public && electron-builder --config electron-builder.public.yml --win portable --x64",
    "build:exe:personal": "npm run build && npm run check:desktop-package && node scripts/build-windows-icon.mjs && electron-builder --config electron-builder.yml --win portable --x64",
    "build:rounded-logo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-rounded-logo.ps1",
    "package:bridge-plugins": "npm run build:rounded-logo && node scripts/package-bridge-plugin-variants.mjs --variant public",
    "package:bridge-plugins:personal": "npm run build:rounded-logo && node scripts/package-bridge-plugin-variants.mjs --variant personal",
    "check:desktop-package": "node scripts/prepack-check.js",
    "check:openapi": "node scripts/check-openapi.mjs",
    "test": "node --experimental-strip-types --import ./scripts/test-register.mjs --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --test scripts/tests/*.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "koffi": "3.3.3",
    "openai": "7.39.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.4.2",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
