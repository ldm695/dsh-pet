{
  "name": "dsh-pet-work-status-bridge",
  "version": "0.2.0",
  "description": "为 DSH Desktop 上报会话状态与窗口焦点，供 DSH Pet Windows 应用读取。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.png"
  },
  "icon": "icon.png",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1"
  }
}
